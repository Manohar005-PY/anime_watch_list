# ==============================================================================
# KAGE Frontend Environment Configuration
# ==============================================================================
# Leave NEXT_PUBLIC_API_URL empty or set to "/api/v1" for same-origin reverse-proxy mode
# Or specify an absolute URL (e.g. "http://localhost:8000/api/v1") for direct CORS mode
NEXT_PUBLIC_API_URL="/api/v1"
NODE_ENV="development"

# Internal backend URL used by Next.js reverse-proxy rewrites
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"
