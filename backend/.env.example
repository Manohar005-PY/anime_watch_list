# KAGE Backend Environment Configuration
PROJECT_NAME="KAGE"
ENVIRONMENT="development"
DEBUG=true

# Security & Secrets (Use a 32+ character random string in production)
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-32-chars"
SESSION_COOKIE_NAME="kage_session"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://kage:kage_dev_secret@localhost:5432/kage_db"

# CORS allowed frontend origins
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
