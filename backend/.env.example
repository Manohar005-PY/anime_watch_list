# ==============================================================================
# KAGE Backend Environment Configuration
# ==============================================================================
PROJECT_NAME="KAGE"
ENVIRONMENT="development"  # "development", "production", "test"
DEBUG=true

# Security & Secrets
# In production: generate using: openssl rand -hex 64 (min 64 chars / 256 bits of entropy)
SECRET_KEY="dev-secret-key-change-in-production-kage-super-secret-key-minimum-32-chars"
SESSION_COOKIE_NAME="kage_session"
SESSION_COOKIE_SECURE=false  # Set to true in production (HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE="lax"
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CSRF & Origin Defense
CSRF_COOKIE_NAME="kage_csrf"
ENFORCE_ORIGIN_CHECK=true

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://kage:kage_dev_secret@localhost:5432/kage_db"
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# CORS Allowed Frontend Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Transactional Email (SMTP Configuration)
# In production: EMAIL_PROVIDER must be "smtp" and SMTP_HOST must be configured.
# In development: "console" or "mock" may be used.
EMAIL_PROVIDER="console"  # "smtp", "console", "mock"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=true
EMAILS_FROM_EMAIL="no-reply@kage-archive.local"
EMAILS_FROM_NAME="KAGE Anime Library"
FRONTEND_URL="http://localhost:3000"

# Metadata & Cron Scheduler
METADATA_PROVIDER="kitsu"
SCHEDULER_SECRET_TOKEN="dev-scheduler-secret-token-change-in-production"
